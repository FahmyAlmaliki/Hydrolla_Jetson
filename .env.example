# ─────────────────────────────────────────────────────────────
#  HYDROLA — Environment Variables Template
#  Salin file ini ke .env.local dan isi nilainya.
#  Selama INFLUXDB_URL kosong, sistem otomatis pakai mock data.
# ─────────────────────────────────────────────────────────────

# ── InfluxDB ──────────────────────────────────────────────────
# URL InfluxDB (lokal Jetson Nano atau development)
INFLUXDB_URL=
# Token akses (buat di InfluxDB UI: Data > Tokens)
INFLUXDB_TOKEN=
# Nama organisasi yang dibuat saat setup InfluxDB
INFLUXDB_ORG=hydrola
# Nama bucket tempat data sensor disimpan
INFLUXDB_BUCKET=water_quality

# ── App ───────────────────────────────────────────────────────
# Interval polling data real-time (detik). Default: 10
NEXT_PUBLIC_POLL_INTERVAL_SEC=10
# Set ke "true" untuk paksa pakai mock data meski InfluxDB tersedia
NEXT_PUBLIC_FORCE_MOCK=false
